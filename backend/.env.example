DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require
COGNITO_REGION=us-west-2
COGNITO_USER_POOL_ID=us-west-2_xxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
MEDIA_BUCKET=kaam-staging-media-xxxx
# Vercel reserves AWS_* names, so these carry a MEDIA_ prefix
MEDIA_AWS_ACCESS_KEY_ID=
MEDIA_AWS_SECRET_ACCESS_KEY=
MEDIA_AWS_REGION=us-west-2
CORS_ORIGINS=http://localhost:8081
# Local development only: accept "dev:<sub>:<email>" bearer tokens instead of Cognito JWTs
AUTH_DEV_BYPASS=false

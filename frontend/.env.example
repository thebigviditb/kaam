# Base URL of the Kaam API (no trailing slash)
EXPO_PUBLIC_API_URL=http://localhost:8000

# AWS Cognito user pool (from the infra stack outputs)
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-west-2_xxxxxxx
EXPO_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Local development only. When "true" the login screen asks for a dev user id + email
# and the app sends "Bearer dev:<id>:<email>" (the API must run with AUTH_DEV_BYPASS=true).
EXPO_PUBLIC_AUTH_DEV_BYPASS=false

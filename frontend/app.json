{
  "expo": {
    "name": "Kaam",
    "slug": "kaam",
    "version": "1.0.0",
    "scheme": "kaam",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.kaam.mobile"
    },
    "android": {
      "package": "app.kaam.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFF1EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kaam uses your photos and videos to show your work on your profile."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
